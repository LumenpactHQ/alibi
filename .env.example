# Placeholders only. Copy to .env and fill in your own values. Never commit .env.

# --- Zetaris (local Docker install) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_USERNAME=your-zetaris-sign-in-email
ZETARIS_PASSWORD=your-zetaris-password

# --- Model access (fill in after reading the Meterless / NVIDIA setup steps) ---
MODEL_PROVIDER=meterless
MODEL_API_KEY=your-model-api-key
MODEL_NAME=your-model-name

# --- App ---
SAMPLE_MODE=false
